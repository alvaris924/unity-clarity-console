/*
 * Ember: warm black panels, one amber accent, and a glow that spreads from the left edge of the
 * selected row like a coal catching. Gold warnings and coral errors keep severity readable, headers are
 * small caps in the mono face, and the source blocks carry a thin amber edge. All original work; the
 * glow texture is generated by Tools~/make_textures.py.
 */

.cc-root {
    --cc-bg: #0e0d0c;
    --cc-panel: #151311;
    --cc-row-alt: #1a1815;
    --cc-text: #ebe4d8;
    --cc-text-dim: #8f8578;
    --cc-border: rgba(255, 159, 67, 0.22);
    --cc-accent: #ff9f43;
    --cc-accent-soft: rgba(255, 159, 67, 0.18);
    --cc-row-hover: rgba(255, 159, 67, 0.07);
    --cc-hover: rgba(255, 159, 67, 0.08);
    --cc-toolbar: #121110;
    --cc-log: #f1d5a0;
    --cc-warning: #ffc857;
    --cc-error: #ff5c5c;
    --cc-marker: #7a6f63;
    --cc-link: #d9a466;
    --cc-link-hover: #ffbe72;
    --cc-timeline-bg: rgba(255, 159, 67, 0.05);
    --cc-chip-bg: rgba(255, 159, 67, 0.05);
}

.cc-mono,
.cc-cell,
.cc-frame,
.cc-src-line,
.cc-detail-message .unity-text-field__input,
.cc-status {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

.cc-frame-entry,
.cc-src-hit,
.cc-chip-selected {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Bold.ttf");
}

.unity-toolbar {
    background-color: var(--cc-toolbar);
    border-top-width: 1px;
    border-top-color: var(--cc-accent);
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
}

.unity-toolbar-button,
.unity-toolbar-toggle,
.unity-toolbar-menu {
    background-color: transparent;
    border-color: transparent;
    color: var(--cc-text);
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

.unity-toolbar-button:hover,
.unity-toolbar-toggle:hover,
.unity-toolbar-menu:hover {
    background-color: var(--cc-hover);
    color: var(--cc-accent);
}

.unity-toolbar-toggle:checked {
    background-color: var(--cc-accent-soft);
    color: var(--cc-accent);
}

.unity-toolbar-search-field {
    background-color: var(--cc-bg);
    border-color: var(--cc-border);
    border-radius: 3px;
}

.unity-toolbar-search-field .unity-text-field__input {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
    color: var(--cc-text);
}

.cc-channels {
    border-bottom-color: var(--cc-border);
}

.cc-chip {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

.cc-timeline {
    border-width: 1px;
    border-color: var(--cc-border);
    border-radius: 2px;
}

.unity-multi-column-header {
    background-color: var(--cc-toolbar);
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
}

.unity-multi-column-header__column {
    border-right-color: rgba(255, 159, 67, 0.1);
}

.unity-multi-column-header__column__title {
    color: var(--cc-accent);
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-definition: url("../Fonts/JetBrainsMono-Bold.ttf");
}

.unity-collection-view__item {
    background-color: var(--cc-panel);
    border-left-width: 2px;
    border-left-color: transparent;
}

.unity-collection-view__item--alternative-background {
    background-color: var(--cc-row-alt);
}

.unity-collection-view__item:hover {
    background-color: var(--cc-row-hover);
}

/* The selected row glows from its left edge: a 64x1 gradient stretched across the row. */
.unity-collection-view__item--selected,
.unity-collection-view__item--selected:hover,
.unity-list-view__item--selected {
    background-color: var(--cc-panel);
    background-image: url("ember-row-glow.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: var(--cc-accent);
}

.unity-scroller {
    background-color: var(--cc-bg);
}

.unity-base-slider__tracker {
    background-color: transparent;
    border-color: transparent;
}

.unity-base-slider__dragger {
    background-color: rgba(255, 159, 67, 0.3);
    border-color: transparent;
    border-radius: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: rgba(255, 159, 67, 0.55);
}

.unity-text-field__input,
.unity-base-text-field__input {
    background-color: var(--cc-bg);
    border-color: var(--cc-border);
    color: var(--cc-text);
}

.cc-src {
    background-color: var(--cc-bg);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: var(--cc-accent);
    border-radius: 0;
}

.cc-src-inline {
    background-color: var(--cc-bg);
    border-left-width: 2px;
    border-left-color: rgba(255, 159, 67, 0.4);
    margin: 1px 10px 8px 18px;
}

.cc-src-header {
    color: var(--cc-accent);
    letter-spacing: 1px;
    border-bottom-color: var(--cc-border);
}

.cc-src-hit {
    background-color: var(--cc-accent-soft);
}

.cc-hover {
    background-color: var(--cc-bg);
    border-color: var(--cc-accent);
}

.cc-status {
    letter-spacing: 1px;
    font-size: 10px;
}

.unity-two-pane-split-view__dragline-anchor {
    background-color: var(--cc-border);
}
