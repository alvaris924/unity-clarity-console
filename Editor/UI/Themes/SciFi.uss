/*
 * Sci-fi: deep navy panels, one cyan accent for anything live or selected, amber and hot red for
 * warnings and errors so severity still reads at a glance, a monospace face throughout, uppercase
 * letter-spaced headers, a glowing frame around the source preview and a faint scanline overlay.
 * All original work; the two textures are generated procedurally by Tools~/make_textures.py.
 */

.cc-root {
    --cc-bg: #070b14;
    --cc-panel: #0b1220;
    --cc-row-alt: #0e1628;
    --cc-text: #d6e7ff;
    --cc-text-dim: #6f86a8;
    --cc-border: rgba(34, 211, 238, 0.28);
    --cc-accent: #22d3ee;
    --cc-accent-soft: rgba(34, 211, 238, 0.16);
    --cc-row-hover: rgba(34, 211, 238, 0.07);
    --cc-hover: rgba(34, 211, 238, 0.08);
    --cc-toolbar: #0a1020;
    --cc-log: #7dd3fc;
    --cc-warning: #ffb020;
    --cc-error: #ff4d6d;
    --cc-marker: #4c6a8c;
    --cc-link: #7fb8cc;
    --cc-link-hover: #22d3ee;
    --cc-timeline-bg: rgba(34, 211, 238, 0.06);
    --cc-chip-bg: rgba(34, 211, 238, 0.05);
}

.cc-overlay {
    background-image: url("scanlines.png");
    background-repeat: repeat;
    background-size: 4px 4px;
    opacity: 0.55;
}

.cc-mono,
.cc-cell,
.cc-frame,
.cc-src-line,
.cc-detail-message .unity-text-field__input,
.cc-status {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

.cc-frame-entry,
.cc-src-hit,
.cc-chip-selected {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Bold.ttf");
}

.unity-toolbar {
    background-color: var(--cc-toolbar);
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
}

.unity-toolbar-button,
.unity-toolbar-toggle,
.unity-toolbar-menu {
    background-color: transparent;
    border-color: transparent;
    color: var(--cc-text-dim);
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
    letter-spacing: 1px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.unity-toolbar-button:hover,
.unity-toolbar-toggle:hover,
.unity-toolbar-menu:hover {
    background-color: var(--cc-hover);
    color: var(--cc-text);
}

.unity-toolbar-toggle:checked {
    background-color: var(--cc-accent-soft);
    color: var(--cc-accent);
    border-bottom-width: 2px;
    border-bottom-color: var(--cc-accent);
}

.unity-toolbar-search-field {
    background-color: var(--cc-bg);
    border-color: var(--cc-border);
    border-radius: 2px;
}

.unity-toolbar-search-field .unity-text-field__input {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
    color: var(--cc-text);
}

.cc-channels {
    border-bottom-color: var(--cc-border);
}

.cc-chip {
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

.cc-timeline {
    border-width: 1px;
    border-color: var(--cc-border);
    border-radius: 2px;
}

.unity-multi-column-header {
    background-color: var(--cc-toolbar);
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
}

.unity-multi-column-header__column {
    border-right-color: rgba(34, 211, 238, 0.12);
}

.unity-multi-column-header__column__title {
    color: var(--cc-accent);
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-definition: url("../Fonts/JetBrainsMono-Bold.ttf");
}

.unity-collection-view__item {
    background-color: var(--cc-panel);
    border-left-width: 2px;
    border-left-color: transparent;
}

.unity-collection-view__item--alternative-background {
    background-color: var(--cc-row-alt);
}

.unity-collection-view__item:hover {
    background-color: var(--cc-row-hover);
}

.unity-collection-view__item--selected,
.unity-collection-view__item--selected:hover,
.unity-list-view__item--selected {
    background-color: var(--cc-accent-soft);
    border-left-color: var(--cc-accent);
}

.unity-scroller {
    background-color: var(--cc-bg);
}

.unity-base-slider__tracker {
    background-color: transparent;
    border-color: transparent;
}

.unity-base-slider__dragger {
    background-color: rgba(34, 211, 238, 0.35);
    border-color: transparent;
    border-radius: 1px;
}

.unity-base-slider__dragger:hover {
    background-color: rgba(34, 211, 238, 0.6);
}

.unity-text-field__input,
.unity-base-text-field__input {
    background-color: var(--cc-bg);
    border-color: var(--cc-border);
    color: var(--cc-text);
}

.cc-src {
    border-width: 0;
    background-color: transparent;
    background-image: url("glow-frame.png");
    -unity-slice-left: 14;
    -unity-slice-top: 14;
    -unity-slice-right: 14;
    -unity-slice-bottom: 14;
    padding: 14px 16px 16px 16px;
    margin: 6px 10px 10px 10px;
}

.cc-src-inline {
    background-image: none;
    background-color: var(--cc-panel);
    border-left-width: 2px;
    border-left-color: rgba(34, 211, 238, 0.35);
    padding: 4px 8px 4px 8px;
    margin: 1px 10px 8px 18px;
}

.cc-src-header {
    color: var(--cc-accent);
    letter-spacing: 1px;
    border-bottom-color: var(--cc-border);
}

.cc-src-hit {
    background-color: var(--cc-accent-soft);
    border-left-width: 2px;
    border-left-color: var(--cc-accent);
}

.cc-status {
    letter-spacing: 1px;
    font-size: 10px;
}

.unity-two-pane-split-view__dragline-anchor {
    background-color: var(--cc-border);
}
