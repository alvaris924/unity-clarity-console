/*
 * Clarity Console: structure only. Every colour, font and texture comes from the active theme in
 * Themes/, which defines the --cc-* variables this sheet consumes. Add a theme by adding a sheet that
 * defines the same variables; nothing here needs to change.
 */

.cc-root {
    flex-grow: 1;
    background-color: var(--cc-bg);
    color: var(--cc-text);
}

.cc-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cc-split {
    flex-grow: 1;
}

/* The toolbar flows onto a second line when the window is too narrow for one, instead of clipping
   the severity toggles on the right. Buttons keep their size. The search field and the toggles form
   one group that first gives up search width, then moves to the next line as a whole. */
.cc-toolbar {
    flex-wrap: wrap;
    height: auto;
    min-height: 21px;
}

/* Explicit heights: the built-in controls size themselves from the toolbar, which no longer has a
   fixed height once it can wrap, so each line takes the height the toolbar used to have. */
.cc-toolbar > * {
    flex-shrink: 0;
    height: 20px;
}

.cc-toolbar-right {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 250px;
    min-width: 250px;
    max-width: 390px;
}

.cc-toolbar-right > .unity-toolbar-toggle {
    height: 20px;
}

.cc-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    max-width: 220px;
}

.cc-search-invalid {
    border-color: var(--cc-error);
    border-width: 1px;
}

.cc-status-error {
    color: var(--cc-error);
}

.cc-toggle {
    min-width: 52px;
    -unity-text-align: middle-left;
}

.cc-toggle-icon {
    width: 14px;
    height: 14px;
    margin-left: 4px;
    margin-right: 2px;
    align-self: center;
}

.cc-channels {
    flex-direction: column;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
    background-color: var(--cc-bg);
}

.cc-channels-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.cc-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px 4px;
}

.cc-channels-handle {
    height: 5px;
    flex-shrink: 0;
    cursor: split-resize-up-down;
}

.cc-channels-handle:hover {
    background-color: var(--cc-hover);
}

.cc-chip {
    margin: 1px 2px;
    padding: 0 7px;
    height: 17px;
    font-size: 10px;
    border-radius: 2px;
    border-width: 1px;
    background-color: var(--cc-chip-bg);
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.cc-chip:hover {
    background-color: var(--cc-hover);
}

.cc-chip-selected {
    -unity-font-style: bold;
}

.cc-chip-overflow {
    color: var(--cc-text-dim);
    border-color: var(--cc-border);
}

.cc-timeline {
    height: 28px;
    flex-shrink: 0;
    margin: 2px 4px 0 4px;
    background-color: var(--cc-timeline-bg);
    border-radius: 3px;
    --cc-timeline-log: var(--cc-log);
    --cc-timeline-warning: var(--cc-warning);
    --cc-timeline-error: var(--cc-error);
}

.cc-list {
    flex-grow: 1;
    min-height: 60px;
    background-color: var(--cc-panel);
}

.cc-cell {
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--cc-text);
}

.cc-cell-icon {
    width: 14px;
    height: 14px;
    align-self: center;
    margin-left: 4px;
}

/* Wrap mode: the message cell wraps and every cell aligns to the first line of a tall row. */
.cc-wrap .cc-cell {
    -unity-text-align: upper-left;
    padding-top: 3px;
    padding-bottom: 2px;
}

.cc-wrap .cc-cell-message {
    white-space: normal;
    text-overflow: clip;
}

.cc-wrap .cc-cell-icon {
    align-self: flex-start;
    margin-top: 3px;
}

.cc-wrap .cc-frame {
    white-space: normal;
}

.cc-msg-warning {
    color: var(--cc-warning);
}

.cc-msg-error {
    color: var(--cc-error);
}

.cc-marker {
    color: var(--cc-marker);
    -unity-font-style: italic;
}

.cc-detail {
    flex-grow: 1;
    min-height: 60px;
    margin: 0;
    background-color: var(--cc-panel);
}

.cc-detail-message {
    flex-shrink: 0;
    margin: 0;
}

.cc-frames {
    padding: 3px 6px;
}

.cc-frame {
    padding: 1px 2px;
    white-space: nowrap;
    color: var(--cc-text);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.cc-frame-link {
    color: var(--cc-link);
}

.cc-frame-link:hover {
    color: var(--cc-link-hover);
    background-color: var(--cc-hover);
}

.cc-frame-entry {
    -unity-font-style: bold;
}

.cc-frame-hidden {
    color: var(--cc-text-dim);
    -unity-font-style: italic;
}

.cc-frame-hidden:hover {
    background-color: var(--cc-hover);
}

.cc-frame-selected {
    background-color: var(--cc-accent-soft);
}

.cc-src {
    margin: 4px 6px 6px 6px;
    border-width: 1px;
    border-color: var(--cc-border);
    border-radius: 4px;
    padding-bottom: 2px;
    background-color: var(--cc-bg);
}

.cc-src-inline {
    margin: 1px 6px 6px 16px;
}

/* The hover card: a longer stretch of source floating over the pane while the pointer rests on a frame. */
.cc-hover {
    background-color: var(--cc-panel);
    border-width: 1px;
    border-color: var(--cc-accent);
    border-radius: 4px;
    padding-bottom: 2px;
    max-width: 92%;
    overflow: hidden;
}

.cc-src-header {
    font-size: 10px;
    color: var(--cc-text-dim);
    padding: 2px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cc-border);
}

.cc-src-lines {
    padding: 2px 0;
}

.cc-src-line {
    padding: 0 6px;
    white-space: nowrap;
    -unity-font-style: normal;
    color: var(--cc-text);
}

.cc-src-hit {
    background-color: var(--cc-accent-soft);
    -unity-font-style: bold;
}

.cc-status {
    padding: 2px 6px;
    color: var(--cc-text-dim);
    border-top-width: 1px;
    border-top-color: var(--cc-border);
    background-color: var(--cc-bg);
}
