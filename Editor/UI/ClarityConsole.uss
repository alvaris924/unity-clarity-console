/* Clarity Console window. Colors live in variables so a user stylesheet can retheme the window. */

.cc-root {
    flex-grow: 1;
}

.cc-dark {
    --cc-warning: #f5a623;
    --cc-error: #ff6b6b;
    --cc-marker: #8fa3bf;
    --cc-status: #9a9a9a;
    --cc-link: #4fc1ff;
    --cc-link-hover: #9fdcff;
}

.cc-light {
    --cc-warning: #9a6400;
    --cc-error: #b00020;
    --cc-marker: #55607a;
    --cc-status: #555555;
    --cc-link: #0b5ed7;
    --cc-link-hover: #0842a0;
}

.cc-split {
    flex-grow: 1;
}

.cc-search-invalid {
    border-color: var(--cc-error);
    border-width: 1px;
}

.cc-status-error {
    color: var(--cc-error);
}

.cc-channels {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.cc-chip {
    margin: 1px 2px;
    padding: 0 7px;
    height: 17px;
    font-size: 10px;
    border-radius: 9px;
    border-width: 1px;
    background-color: rgba(127, 127, 127, 0.08);
    -unity-text-align: middle-center;
}

.cc-chip:hover {
    background-color: rgba(127, 127, 127, 0.22);
}

.cc-chip-selected {
    -unity-font-style: bold;
}

.cc-chip-overflow {
    color: var(--cc-status);
    border-color: rgba(127, 127, 127, 0.35);
}

.cc-list {
    flex-grow: 1;
    min-height: 60px;
}

.cc-search {
    width: 220px;
}

.cc-toggle {
    min-width: 52px;
    -unity-text-align: middle-left;
}

.cc-toggle-icon {
    width: 14px;
    height: 14px;
    margin-left: 4px;
    margin-right: 2px;
    align-self: center;
}

.cc-cell {
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cc-cell-icon {
    width: 14px;
    height: 14px;
    align-self: center;
}

.cc-msg-warning {
    color: var(--cc-warning);
}

.cc-msg-error {
    color: var(--cc-error);
}

.cc-marker {
    color: var(--cc-marker);
    -unity-font-style: italic;
}

.cc-detail {
    flex-grow: 1;
    min-height: 60px;
    margin: 0;
}

.cc-detail-message {
    flex-shrink: 0;
    margin: 0;
}

.cc-frames {
    padding: 3px 6px;
}

.cc-frame {
    font-size: 11px;
    padding: 1px 2px;
    white-space: nowrap;
}

.cc-frame-link {
    color: var(--cc-link);
}

.cc-frame-link:hover {
    color: var(--cc-link-hover);
    background-color: rgba(127, 127, 127, 0.15);
}

.cc-frame-entry {
    -unity-font-style: bold;
}

.cc-frame-selected {
    background-color: rgba(127, 127, 127, 0.18);
}

.cc-src {
    margin: 4px 6px 6px 6px;
    border-width: 1px;
    border-color: rgba(127, 127, 127, 0.35);
    border-radius: 4px;
    padding-bottom: 2px;
}

.cc-src-header {
    font-size: 10px;
    color: var(--cc-status);
    padding: 2px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 127, 127, 0.25);
}

.cc-src-lines {
    padding: 2px 0;
}

.cc-src-line {
    font-size: 11px;
    padding: 0 6px;
    white-space: nowrap;
    -unity-font-style: normal;
}

.cc-src-hit {
    background-color: rgba(43, 127, 212, 0.28);
    -unity-font-style: bold;
}

.cc-status {
    padding: 2px 6px;
    font-size: 11px;
    color: var(--cc-status);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}
