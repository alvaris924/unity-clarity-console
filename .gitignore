# Clarity Console is a package-at-root repository.
# Unity only generates files inside the development project in DevProject~/,
# so every Unity pattern below is prefixed with that folder.

# Unity generated (development project)
DevProject~/[Ll]ibrary/
DevProject~/[Tt]emp/
DevProject~/[Oo]bj/
DevProject~/[Bb]uild/
DevProject~/[Bb]uilds/
DevProject~/[Ll]ogs/
DevProject~/[Uu]ser[Ss]ettings/
DevProject~/[Mm]emoryCaptures/
DevProject~/[Rr]ecordings/
DevProject~/[Aa]ssets/AddressableAssetsData/*/*.bin*
DevProject~/[Aa]ssets/StreamingAssets/aa/
DevProject~/.vsconfig
DevProject~/crashlytics-build.properties

# IDE and project files (generated by Unity for DevProject~)
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
ExportedObj/

# Build artifacts that must never ship in the package
*.unitypackage
*.apk
*.aab
*.app

# OS
.DS_Store
._*
Thumbs.db
desktop.ini

# Misc
*.tmp
*.log
!Tests/**/Fixtures/**/*.log
